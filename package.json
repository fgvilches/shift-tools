{
  "name": "shift-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "icons": "tauri icon docs/brand/app-icon-1024.png",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml -- --test-threads=1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.9.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgvilches/shift-tools.git"
  },
  "author": "Felipe González (shift)",
  "license": "MIT",
  "homepage": "https://github.com/fgvilches/shift-tools",
  "bugs": {
    "url": "https://github.com/fgvilches/shift-tools/issues"
  }
