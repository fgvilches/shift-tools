{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shift-tools",
  "version": "1.1.0",
  "identifier": "com.shift.tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "shift-tools",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 21
        },
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A macOS Swiss army knife for developers, network engineers and testers.",
    "longDescription": "shift-tools bundles process, disk, network, security and API utilities into one native macOS window with a Rust core and a Tauri 2 shell.",
    "copyright": "© 2026 shift",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRTlENkJERUJFQUQ3MUEKUldRYTErcnJ2ZGJwVG1KUU1OZ3Vwdi9vN3hVQTBKcEFFa3lKVDBoNzRUT1RIT2kzRDVrMzJwR0IK",
      "endpoints": [
        "https://github.com/fgvilches/shift-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
